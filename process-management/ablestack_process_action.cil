; Copyright 2026 ABLECLOUD. Apache-2.0.
; Fixed native entrypoint only. No QGA-wide proc/systemd read permissions.
(type ablestack_process_action_t)
(typeattributeset domain (ablestack_process_action_t))
(roletype system_r ablestack_process_action_t)
(type ablestack_process_action_exec_t)
(typeattributeset file_type (ablestack_process_action_exec_t))
(typeattributeset exec_type (ablestack_process_action_exec_t))
(type ablestack_process_action_data_t)
(typeattributeset file_type (ablestack_process_action_data_t))
(typetransition virt_qemu_ga_t ablestack_process_action_exec_t process ablestack_process_action_t)
(allow virt_qemu_ga_t ablestack_process_action_exec_t (file (getattr open read execute map)))
(allow virt_qemu_ga_t ablestack_process_action_data_t (file (getattr open read)))
(allow virt_qemu_ga_t ablestack_process_action_t (process (transition)))
(allow ablestack_process_action_t ablestack_process_action_exec_t (file (entrypoint getattr open read execute map)))
(allow ablestack_process_action_t ablestack_process_action_data_t (file (getattr open read)))
(allow ablestack_process_action_t virt_qemu_ga_t (fd (use)))
(allow ablestack_process_action_t virt_qemu_ga_t (fifo_file (getattr read write ioctl)))
(allow ablestack_process_action_t virt_qemu_ga_t (process (sigchld)))
(allow ablestack_process_action_t self (process (fork sigchld signal sigkill signull getpgid setpgid)))
(allow ablestack_process_action_t self (fifo_file (create getattr open read write ioctl)))
; procfs uses each target process domain as the file/dir label.
(allow ablestack_process_action_t domain (dir (getattr search)))
(allow ablestack_process_action_t domain (file (getattr open read)))
(allow ablestack_process_action_t proc_t (dir (getattr open read search)))
(allow ablestack_process_action_t proc_t (file (getattr open read)))
(allow ablestack_process_action_t file_type (dir (getattr search)))
(allow ablestack_process_action_t bin_t (file (getattr open read execute execute_no_trans map)))
(allow ablestack_process_action_t systemd_systemctl_exec_t (file (getattr open read execute execute_no_trans map)))
(allow ablestack_process_action_t lib_t (file (getattr open read execute map)))
(allow ablestack_process_action_t ld_so_t (file (getattr open read execute map)))
(allow ablestack_process_action_t ld_so_cache_t (file (getattr open read map)))
(allow ablestack_process_action_t usr_t (file (getattr open read map)))
(allow ablestack_process_action_t locale_t (file (getattr open read map)))
(allow ablestack_process_action_t passwd_file_t (file (getattr open read)))
(allow ablestack_process_action_t sysctl_kernel_t (file (getattr open read)))
(allow ablestack_process_action_t sysctl_t (file (getattr open read)))
(allow ablestack_process_action_t file_type (lnk_file (getattr read)))
(allow ablestack_process_action_t self (unix_stream_socket (create connect read write getattr getopt setopt shutdown)))
(allow ablestack_process_action_t init_var_run_t (sock_file (write)))
(allow ablestack_process_action_t init_t (unix_stream_socket (connectto)))
(allow ablestack_process_action_t init_t (lnk_file (getattr read)))
; systemd still enforces service-class permissions on the caller context.
; EL9 manager queries use service:status; EL10 uses system:status.
(allow ablestack_process_action_t init_t (service (status)))
(optional ablestack_process_action_system_status
  (allow ablestack_process_action_t init_t (system (status))))
(allow ablestack_process_action_t systemd_unit_file_type (service (status)))
(allow ablestack_process_action_t security_t (dir (getattr search)))
(allow ablestack_process_action_t security_t (file (getattr open read map)))
(allow ablestack_process_action_t device_t (dir (getattr search)))
(allow ablestack_process_action_t null_device_t (chr_file (getattr open read write ioctl)))
(allow ablestack_process_action_t urandom_device_t (chr_file (getattr open read)))

; Only the fixed action entrypoint receives mutation permissions, never QGA itself.
(allow ablestack_process_action_t self (capability (kill)))
(allow ablestack_process_action_t domain (process (signal sigkill signull)))
(allow ablestack_process_action_t domain (lnk_file (getattr read)))
(allow ablestack_process_action_t systemd_unit_file_type (service (start stop)))
(type ablestack_process_action_state_t)
(typeattributeset file_type (ablestack_process_action_state_t))
(allow ablestack_process_action_t ablestack_process_action_state_t (dir (getattr search open read write add_name remove_name)))
(allow ablestack_process_action_t ablestack_process_action_state_t (file (create getattr open read write lock rename unlink setattr)))
(typetransition ablestack_process_action_t ablestack_process_action_state_t file ablestack_process_action_state_t)
