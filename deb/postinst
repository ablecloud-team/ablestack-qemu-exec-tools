#!/bin/bash
set -e

# Process repair must not initialize cloud-init, DHCP or guest credentials.
if [ "${ABLESTACK_TOOLS_MODE:-}" = "process-management" ]; then
    /usr/bin/agent_policy_fix --policy process-management --apply --json
    exit $?
fi

echo "Running post-install tasks for ablestack-qemu-exec-tools..."

if [ -x /usr/bin/agent_policy_fix ]; then
    /usr/bin/agent_policy_fix --policy full --apply || echo "[WARN] agent_policy_fix failed"
fi

if [ -x /usr/bin/cloud_init_auto ]; then
    /usr/bin/cloud_init_auto || echo "[WARN] cloud_init_auto failed"
fi

exit 0
